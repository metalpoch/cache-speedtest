# Copia este archivo a .env y ajusta las URIs.
# Los valores por defecto funcionan dentro de docker compose (nombres de servicio).
REDIS_URL=redis://valkey:6379/0
DATABASE_URL=postgresql://bench:bench@postgres:5432/bench

# Si corres la app en tu máquina (uvicorn) contra los contenedores, usa:
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql://bench:bench@localhost:5432/bench

POSTGRES_USER=bench
POSTGRES_PASSWORD=bench
POSTGRES_DB=bench

MEMORY_MAX_SIZE=4096
MEMORY_TTL_SECONDS=3600
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=10
PG_AUTO_MIGRATE=true

DEFAULT_KEY=theta
DEFAULT_VALUE=42
BENCHMARK_ITERATIONS=500
BENCHMARK_WARMUP=50
BENCHMARK_CONCURRENCY=1
